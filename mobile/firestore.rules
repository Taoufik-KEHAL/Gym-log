rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own data, stored under
    // users/{uid}/store/{collection}. See lib/services/firestore_storage_service.dart.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
